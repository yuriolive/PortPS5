OpCapability Shader
OpCapability SignedZeroInfNanPreserve
OpExtension "SPV_KHR_float_controls"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %gl_VertexIndex %gl_InstanceIndex %outPerVertex
OpExecutionMode %main SignedZeroInfNanPreserve 32
OpName %gl_VertexIndex "gl_VertexIndex"
OpName %gl_InstanceIndex "gl_InstanceIndex"
OpName %gl_PerVertex "gl_PerVertex"
OpName %outPerVertex "outPerVertex"
OpName %main "main"
OpDecorate %gl_VertexIndex BuiltIn VertexIndex
OpDecorate %gl_InstanceIndex BuiltIn InstanceIndex
OpMemberDecorate %gl_PerVertex 0 BuiltIn Position
OpDecorate %gl_PerVertex Block
%uint = OpTypeInt 32 0
%int = OpTypeInt 32 1
%_ptr_Input_int = OpTypePointer Input %int
%gl_VertexIndex = OpVariable %_ptr_Input_int Input
%gl_InstanceIndex = OpVariable %_ptr_Input_int Input
%float = OpTypeFloat 32
%v4float = OpTypeVector %float 4
%gl_PerVertex = OpTypeStruct %v4float
%_ptr_Output_gl_PerVertex = OpTypePointer Output %gl_PerVertex
%outPerVertex = OpVariable %_ptr_Output_gl_PerVertex Output
%void = OpTypeVoid
%16 = OpTypeFunction %void
%uint_0 = OpConstant %uint 0
%v4uint = OpTypeVector %uint 4
%bool = OpTypeBool
%true = OpConstantTrue %bool
%uint_1065353216 = OpConstant %uint 1065353216
%_ptr_Output_v4float = OpTypePointer Output %v4float
%36 = OpConstantComposite %v4uint %uint_0 %uint_0 %uint_0 %uint_0
%main = OpFunction %void None %16
%12 = OpLabel
%29 = OpBitcast %float %uint_0
%33 = OpCompositeConstruct %v4float %29 %29 %29 %29
%34 = OpAccessChain %_ptr_Output_v4float %outPerVertex %uint_0
OpStore %34 %33
OpReturn
OpFunctionEnd

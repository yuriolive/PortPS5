{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-gcc15.cmake"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "User build (Release, no tests, no SPIRV-Tools)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ANYPS5_ENABLE_SPIRV_TOOLS": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Development and local regression (RelWithDebInfo, tests, SPIRV-Tools)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "ANYPS5_ENABLE_SPIRV_TOOLS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Hosted CI (inherits dev, warnings as errors for PortPS5 targets)",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "relinker",
        "libs"
      ]
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "targets": [
        "relinker",
        "libs"
      ]
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "targets": [
        "relinker",
        "libs"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "ci",
      "displayName": "CI Unit Tests",
      "description": "Runs all unit tests in CI",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "unit",
      "displayName": "Unit Tests",
      "description": "Runs all unit-labeled tests",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^unit$"
        }
      }
    },
    {
      "name": "dev",
      "displayName": "All Local Dev Tests",
      "description": "Runs all tests in development",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
